{
  "name": "overseer",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch src/backend/index.ts --api-only",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run build && node src/backend/index.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@types/marked": "^5.0.2",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.5",
    "marked": "^18.0.13",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-solid": "^2.10.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
