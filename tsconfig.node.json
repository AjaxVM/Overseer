{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // The backend runs on Node's native type stripping (no build step), which needs
    // real .ts import paths and rejects enums/namespaces/parameter properties.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/backend", "vite.config.ts"]
}
