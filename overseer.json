      "options": [
        "idea",
        "designing",
        "planning",
        "ready",
        "working",
        "reviewing",
        "done"
      ],
      "optionColors": {
        "idea": "#CC79A7",
        "designing": "#F0E442",
        "planning": "#E69F00",
